{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "strict": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "*.js",
    "scripts/*.js",
    "test/*.js",
    ".quality-html/*.js",
    "types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build-output",
    ".quality-tools",
    "eslint.config.js"
  ]
}
