{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "strict": false,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "*.js",
    "scripts/*.js",
    "test/*.js",
    ".quality-html/*.js"
  ],
  "exclude": [
    "node_modules",
    "build-output",
    ".quality-tools",
    "eslint.config.js"
  ]
}
